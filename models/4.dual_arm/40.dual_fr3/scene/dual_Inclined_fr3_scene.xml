<mujoco model="dual_fr3 scene">
  <option timestep="0.001" gravity="0 0 -9.80665" integrator="implicitfast" cone="elliptic" noslip_iterations="2" />
  <compiler angle="radian" meshdir="../../../3.robot_arm/20.fr3/assets" />

  <include file="../../../3.robot_arm/20.fr3/mjcf/fr3_defaults.xml" />
  <include file="../../../3.robot_arm/20.fr3/mjcf/fr3_assets.xml" />
  <include file="../../../3.robot_arm/20.fr3/mjcf/fr3_contacts.xml" />

  <statistic center="0 0 0.85" extent="1.2" meansize="0.05" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <global azimuth="135" elevation="-20" />
    <quality shadowsize="8192" />
  </visual>

  <asset>
    <mesh file="../../../environments/tablelegs.obj" scale="1.5 1.0 1.0"/>
    <mesh file="../../../environments/tabletop.obj" scale="1.5 1.0 1.0"/>
    <mesh file="../../../environments/_03_franka_adap_asm.stl" />

    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="flat" mark="edge" rgb1="0.1 0.1 0.1" rgb2="0.3 0.5 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <texture type="2d" file="../../../environments/small_meta_table_diffuse.png" />

    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
    <material name="table" texture="small_meta_table_diffuse" />
  </asset>

  <worldbody>
    <!-- World origin markers -->
    <geom type="cylinder" size="0.002 0.05" rgba="1 0 0 1" pos="0.05 -0.0 0." euler="0 1.57079 0" class="visual" />
    <geom type="cylinder" size="0.002 0.05" rgba="0 1 0 1" pos="0 0.05 0." euler="1.57079 0 0" class="visual" />
    <geom type="cylinder" size="0.002 0.05" rgba="0 0 1 1" pos="0 -0.0 0.05" euler="0 0 0" class="visual" />

    <!-- Lighting -->
    <light pos="0 0.1 2.5" />

    <!-- Floor -->
    <geom name="floor" size="10 10 0.05" type="plane" material="groundplane" />
    <site name="worldref" />

    <!-- Table -->
    <geom mesh="tabletop" material="table" class="visual" />
    <geom mesh="tablelegs" material="table" class="visual" />
    <geom name="table" pos="0 0 -0.1009" size="0.61 0.37 0.1" type="box" class="collision" />

    <body name="cooking_surface" pos="0.1 0 0.85">
      <geom type="box" size="0.06 0.06 0.02" class="collision" />
      <geom type="box" size="0.06 0.06 0.02" rgba="0.5 0.5 0.5 1" class="visual" />
    </body>

    <body name="steak_plate" pos="0.1 0 0.88">
      <freejoint name="steak_plate" />
      <geom type="box" mass="1" size="0.08 0.12 0.01" rgba="0.7 0.25 0.2 1" solref="0.001 1" solimp="0. 1 0.0001 0.02 3" />
    </body>

    <!-- Cameras -->
    <camera name="overhead_cam" focal="1.93e-3 1.93e-3" resolution="1280 720" sensorsize="3896e-6 2140e-6" pos="-1.5 0 2" euler="0 -1 -1.57079" />

    <!-- Dual FR3 robots positioned for dual-arm teleoperation -->
    <body name="tf2" pos="-0.4 0.0 0.75">
      <geom mesh="_03_franka_adap_asm" class="visual" />
      <body name="fr3_tf1" pos="0.0 0.1097 0.146" euler="-0.7854 0 0">
        <!-- <include file="../../../3.robot_arm/20.fr3/mjcf/fr3_links.xml" namespace="left_arm"/> -->
        <replicate count="2" sep="-" offset="0.0 -0.1551 -0.1551" euler="1.57 0 0">
          <include file="../../../3.robot_arm/20.fr3/mjcf/fr3_links.xml" />
        </replicate>
      </body>
    </body>

  </worldbody>

  <include file="../../../3.robot_arm/20.fr3/mjcf/fr3_actuators.xml" />
  <include file="../../../3.robot_arm/20.fr3/mjcf/fr3_sensors.xml" />

</mujoco>
