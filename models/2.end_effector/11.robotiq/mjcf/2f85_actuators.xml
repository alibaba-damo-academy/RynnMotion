<mujoco model="2f85_actuators_sensors">

  <contact>
    <exclude body1="base" body2="left_driver"/>
    <exclude body1="base" body2="right_driver"/>
    <exclude body1="base" body2="left_spring_link"/>
    <exclude body1="base" body2="right_spring_link"/>
    <exclude body1="right_coupler" body2="right_follower"/>
    <exclude body1="left_coupler" body2="left_follower"/>
  </contact>

  <tendon>
    <fixed name="split">
      <joint joint="right_driver_joint" coef="0.5"/>
      <joint joint="left_driver_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <connect anchor="0 0 0" body1="right_follower" body2="right_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect anchor="0 0 0" body1="left_follower" body2="left_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="right_driver_joint" joint2="left_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <!--
    Gripper control: 0=closed, 1=open
    Joint range: [0, 0.8] where 0=open, 0.8=closed
    Mapping: ctrl=0 -> joint=0.8 (closed), ctrl=1 -> joint=0 (open)
    With kp=100: gainprm = -0.8 * 100 = -80, biasprm[0] = 0.8 * 100 = 80
  -->

  <actuator>
    <position name="2f85_qx" joint="gripper_joint_x" class="gripper_actuator" />
    <position name="2f85_qy" joint="gripper_joint_y" class="gripper_actuator" />
    <position name="2f85_qz" joint="gripper_joint_z" class="gripper_actuator" />
    <position name="2f85_qrx" joint="gripper_joint_rx" class="gripper_rot_actuator" />
    <position name="2f85_qry" joint="gripper_joint_ry" class="gripper_rot_actuator" />
    <position name="2f85_qrz" joint="gripper_joint_rz" class="gripper_rot_actuator" />
    <!-- 0=closed (joint=0.8), 1=open (joint=0) -->
    <general class="2f85" name="gripper" tendon="split" forcerange="-5 5" ctrlrange="0 1" gainprm="-80 0 0" biasprm="80 -100 -10"/>
  </actuator>

</mujoco>
