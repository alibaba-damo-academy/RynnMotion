<mujoco model="openarm_gripper">

  <!-- <body name="gripper_base" quat="-1 1 0 0" pos="0 0 0.11"> -->
  <body name="gripper_base" pos="0 0 0">

    <!-- Positional Joints -->
    <joint name="gripper_joint_x" axis="1 0 0" class="gripper_slide" />
    <joint name="gripper_joint_y" axis="0 1 0" class="gripper_slide" />
    <joint name="gripper_joint_z" axis="0 0 1" class="gripper_slide" />

    <!-- Rotational Joints -->
    <joint name="gripper_joint_rx" axis="1 0 0" class="gripper_hinge" />
    <joint name="gripper_joint_ry" axis="0 1 0" class="gripper_hinge" />
    <joint name="gripper_joint_rz" axis="0 0 1" class="gripper_hinge" />

    <geom type="cylinder" size="0.002 0.05" rgba="1 0 0 1" pos="0.05 -0.0 0." euler="0 1.57079 0" class="visual"/>
    <geom type="cylinder" size="0.002 0.05" rgba="0 1 0 1" pos="0 0.05 0." euler="1.57079 0 0" class="visual"/>
    <geom type="cylinder" size="0.002 0.05" rgba="0 0 1 1" pos="0 -0.0 0.05" euler="0 0 0" class="visual"/>


    <!-- Base Link -->
    <geom mesh="link7_symp" name="openarm_link7_visual" pos="0 0 -0.5585"  class="visual" material="gray" />
    <geom mesh="link7_symp" name="openarm_link7_collision" pos="0 0 -0.5585"  class="collision" />
    <geom mesh="hand" name="openarm_hand_visual" pos="0 0 -0.5585"  class="visual" material="mirror" />
    <geom mesh="hand" name="openarm_hand_collision" pos="0 0 -0.5584" quat="1 0 0 0" class="collision" />

    <!-- Left Finger -->
    <body name="left_finger" pos="0 0.006 0.1151">
      <inertial pos="0.0064528 0.01702 0.0219685" quat="0.923117 0.0155444 -0.0375274 0.382368" mass="0.0360255" diaginertia="2.48652e-06 2.275e-06 7.38483e-07"/>
      <joint name="left_finger_joint" pos="0 0 0" axis="0 1 0" type="slide" range="0 0.044" actuatorfrcrange="-333 333" class="finger_slide" />
      <geom pos="0 -0.05 -0.673001" quat="1 0 0 0" mesh="finger" class="visual" material="black" />
      <geom pos="0 -0.05 -0.673001" quat="1 0 0 0" mesh="finger" class="collision" />
    </body>

    <!-- Right Finger -->
    <body name="right_finger" pos="0 -0.006 0.1151">
      <inertial pos="0.0064528 -0.01702 0.0219685" quat="0.923117 0.0155444 -0.0375274 0.382368" mass="0.0360255" diaginertia="2.48652e-06 2.275e-06 7.38483e-07"/>
      <joint name="right_finger_joint" pos="0 0 0" axis="0 -1 0" type="slide" range="0 0.044" actuatorfrcrange="-333 333" class="finger_slide" />
      <geom pos="0 0.05 -0.673001" quat="1 0 0 0" mesh="finger1" class="visual" material="black" />
      <geom pos="0 0.05 -0.673001" quat="1 0 0 0" mesh="finger1" class="collision" />
    </body>

  </body>


</mujoco>
