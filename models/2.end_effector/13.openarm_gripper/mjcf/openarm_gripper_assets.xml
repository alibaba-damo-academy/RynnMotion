<mujoco model="openarm_gripper_assets">

  <default>
    <default class="openarm_gripper">
      <joint frictionloss="0.1" armature="0.1" />
      <position kp="1000" />


      <default class="gripper_slide">
        <joint type="slide" damping="0.1" range="-1.2 1.2" />
        <position kp="100" dampratio="0.1" ctrlrange="-1.2 1.2" />
      </default>
      <default class="gripper_hinge">
        <joint type="hinge" damping="0.1" range="-31.415 31.415" />
        <position kp="10" dampratio="0.1" ctrlrange="-3.1415 3.1415" />
      </default>
      <default class="finger_slide">
        <joint type="slide" stiffness="100" damping="10.1" range="0 0.05" />
      </default>
      <default class="dm4310">
        <geom contype="0" conaffinity="0"/>
        <joint damping="0.60" frictionloss="0.052" armature="0.028"/>
        <general biastype="affine"/>
      </default>
      <default class="hinge_passive">
        <joint type="hinge" damping="0.02" range="-31.4 31.4" armature="0.001" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>

      <default class="gripper_actuator">
        <position kp="500" dampratio="1" ctrlrange="-1.2 1.2" />
      </default>
      <default class="gripper_rot_actuator">
        <position kp="500" dampratio="1" ctrlrange="-3.1415 3.1415" />
      </default>

      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" density="0" group="2" />
      </default>
      <default class="collision">
        <geom type="mesh" group="3" solref="0.002 1" solimp="0.95 0.99 0.001"/>
      </default>

      <default class="marker">
        <geom type="box" size="0.009 0.009 0.00001" material="white" contype="0" conaffinity="0" mass="0.0" />
      </default>

    </default>
  </default>

  <asset>
    <mesh name="gripper_base" content_type="model/stl" file="gripper_base.STL" />
    <mesh name="link1" content_type="model/stl" file="link1.STL" />
    <mesh name="llink2" content_type="model/stl" file="llink2.STL" />
    <mesh name="llink3" content_type="model/stl" file="llink3_simp.stl" />
    <mesh name="rlink2" content_type="model/stl" file="rlink2.STL" />
    <mesh name="rlink3" content_type="model/stl" file="rlink3_simp.stl" />

    <material name="mirror" rgba="0 0 0 1" texrepeat="5 5" reflectance="1.0" />
    <material name="white" rgba="1 1 1 1" />
    <material name="gray" rgba="0.15 0.15 0.15 1" />
    <material name="light_gray" rgba="0.6 0.6 0.6 1" />
    <material name="black" rgba="0.15 0.15 0.15 1" />
  </asset>

</mujoco>
