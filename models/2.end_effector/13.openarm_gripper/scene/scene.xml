<mujoco model="scene">
  <compiler angle="radian" meshdir="../assets" texturedir="../assets" />

  <option integrator="implicitfast" impratio="10" cone="elliptic" noslip_iterations="2">
    <flag multiccd="enable" />
  </option>

  <statistic center="0.2 0 0.2" extent="1.0" />

  <visual>
    <headlight diffuse="0.3 0.3 0.3" ambient="0.2 0.2 0.2" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-120" elevation="-20" />
    <quality shadowsize="0" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.0" />
  </asset>

  <include file="../mjcf/openarm_gripper_assets.xml" />

  <worldbody>
    <light pos="0 0 4.5" dir="0 0 -1" directional="true" />
    <light pos="0 -4.5 0.6" dir="0 1 0" directional="true" />
    <geom name="floor" size="1 1 0.05" type="plane" material="groundplane" />

    <geom type="cylinder" size="0.002 0.05" rgba="1 0 0 1" pos="0.05 -0.0 0." euler="0 1.57079 0" class="visual"/>
    <geom type="cylinder" size="0.002 0.05" rgba="0 1 0 1" pos="0 0.05 0." euler="1.57079 0 0" class="visual"/>
    <geom type="cylinder" size="0.002 0.05" rgba="0 0 1 1" pos="0 -0.0 0.05" euler="0 0 0" class="visual"/>

    <replicate count="2" offset="0 -0.3 0" sep="_">
      <include file="../mjcf/openarm_gripper_links.xml" />
    </replicate>

  </worldbody>

  <include file="../mjcf/openarm_gripper_actuators_sensors.xml" />

  <!-- Exclude contact between floor and internal mechanism links -->
  <!-- NOTE: Comment out gripper sections below to match replicate count -->
  <contact>
    <!-- Gripper 0 (for replicate count >= 1) -->
    <exclude body1="world" body2="link1_0"/>
    <exclude body1="world" body2="llink2_0"/>
    <exclude body1="world" body2="rlink2_0"/>
    <exclude body1="world" body2="lslider_0"/>
    <exclude body1="world" body2="rslider_0"/>
    <exclude body1="gripper_base_0" body2="llink3_0"/>
    <exclude body1="gripper_base_0" body2="rlink3_0"/>
    <!-- Gripper 1 (for replicate count >= 2, comment out if count = 1) -->
    <exclude body1="world" body2="link1_1"/>
    <exclude body1="world" body2="llink2_1"/>
    <exclude body1="world" body2="rlink2_1"/>
    <exclude body1="world" body2="lslider_1"/>
    <exclude body1="world" body2="rslider_1"/>
    <exclude body1="gripper_base_1" body2="llink3_1"/>
    <exclude body1="gripper_base_1" body2="rlink3_1"/>
  </contact>

</mujoco>
