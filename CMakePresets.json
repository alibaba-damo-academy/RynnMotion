{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "develop",
      "displayName": "Develop Config",
      "description": "Develop build configuration",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_DEBUG_SYMBOLS": "ON",
        "BUILD_MUJOCO": "ON",
        "BUILD_TESTS": "OFF",
        "BUILD_ROS_MUJOCO": "OFF",
        "BUILD_DEPLOY": "OFF"
      }
    },
    {
      "name": "deployment",
      "displayName": "Deploy Config",
      "description": "Deploy build configuration",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_DEBUG_SYMBOLS": "ON",
        "BUILD_MUJOCO": "ON",
        "BUILD_TESTS": "OFF",
        "BUILD_ROS_MUJOCO": "OFF",
        "BUILD_DEPLOY": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release Build",
      "description": "Optimized build for native deployment",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_DEBUG_SYMBOLS": "OFF",
        "BUILD_MUJOCO": "ON",
        "BUILD_TESTS": "OFF",
        "BUILD_ROS_MUJOCO": "OFF",
        "BUILD_DEPLOY": "ON"
      }
    },
    {
      "name": "rosMujoco",
      "displayName": "ROS Mujoco Build",
      "description": "Build with ROS Mujoco support",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_DEBUG_SYMBOLS": "ON",
        "BUILD_MUJOCO": "ON",
        "BUILD_TESTS": "OFF",
        "BUILD_ROS_MUJOCO": "ON",
        "BUILD_DEPLOY": "OFF"
      }
    },
    {
      "name": "tests",
      "displayName": "Tests Build",
      "description": "Build with tests enabled",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_DEBUG_SYMBOLS": "OFF",
        "BUILD_MUJOCO": "ON",
        "BUILD_TESTS": "ON",
        "BUILD_ROS_MUJOCO": "OFF",
        "BUILD_DEPLOY": "OFF"
      }
    },
    {
      "name": "orin",
      "displayName": "Cross-compilation for Jetson Orin",
      "description": "Cross-compile for Jetson Orin (aarch64)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-orin",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CROSS_COMPILE": "ON",
        "CROSS_TARGET": "orin",
        "ENABLE_DEBUG_SYMBOLS": "OFF",
        "BUILD_MUJOCO": "OFF",
        "BUILD_TESTS": "OFF",
        "BUILD_ROS_MUJOCO": "OFF",
        "BUILD_DEPLOY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "develop",
      "configurePreset": "develop"
    },
    {
      "name": "deployment",
      "configurePreset": "deployment"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "rosMujoco",
      "configurePreset": "rosMujoco"
    },
    {
      "name": "tests",
      "configurePreset": "tests"
    },
    {
      "name": "orin",
      "configurePreset": "orin"
    }
  ]
}